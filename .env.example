# Copy to .env.local. With no keys set the app runs in clearly-labelled DEMO mode.

# --- Coaching model (pick one; Anthropic is used first if both are set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible chat endpoint (OpenAI, Azure OpenAI, OpenRouter, local, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Speech-to-text (server). Uses OPENAI_API_KEY / OPENAI_BASE_URL. ---
# If unset, the browser's built-in live speech recognition is used instead.
STT_MODEL=whisper-1

# --- Text-to-speech (server, optional). Falls back to the device's built-in voice. ---
TTS_MODEL=tts-1
TTS_VOICE=alloy
